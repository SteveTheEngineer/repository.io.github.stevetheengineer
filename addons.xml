<?xml version='1.0' encoding='UTF-8'?>
<addons xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><addon id="repository.io.github.stevetheengineer" name="SteveTheEngineer's Repository" version="1.0.0" provider-name="SteveTheEngineer">
    <requires>
        <import addon="xbmc.addon" version="20.0.0" />
    </requires>

    <extension point="xbmc.addon.repository" name="SteveTheEngineer's Repository">
        <dir>
            <info>https://stevetheengineer.github.io/repository.io.github.stevetheengineer/addons.xml</info>
            <checksum>https://stevetheengineer.github.io/repository.io.github.stevetheengineer/addons.xml.md5</checksum>
            <datadir zip="true">https://stevetheengineer.github.io/repository.io.github.stevetheengineer</datadir>
        </dir>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary>SteveTheEngineer's Repository</summary>
        <description>Repository for addons hosted on SteveTheEngineer's github</description>
        <platform>all</platform>
        <source>https://github.com/SteveTheEngineer/repository.io.github.stevetheengineer</source>
    </extension>
</addon><addon xsi:noNamespaceSchemaLocation="metadata.xsd" id="plugin.program.steves-launcher" name="Applications" version="1.1.1" provider-name="SteveTheEngineer">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>

    <extension point="xbmc.addon.metadata">
        <platform>all</platform>

        <summary>Allows to launch and manage external applications.</summary>
        <description>An application launcher that automatically searches for installed apps with app discovery and installation, media player integration, audio synchronization and input passthrough.</description>

        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>

    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>executable</provides>
    </extension>

    <extension point="xbmc.service" library="service.py" />
</addon></addons>