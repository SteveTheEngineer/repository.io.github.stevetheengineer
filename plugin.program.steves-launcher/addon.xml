<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<addon xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="metadata.xsd" id="plugin.program.steves-launcher"
    name="Applications" version="1.1.2" provider-name="SteveTheEngineer"
>
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>

    <extension point="xbmc.addon.metadata">
        <platform>all</platform>

        <summary>Allows to launch and manage external applications.</summary>
        <description>An application launcher that automatically searches for installed apps with app discovery and installation, media player integration, audio synchronization and input passthrough.</description>

        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>

    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>executable</provides>
    </extension>

    <extension point="xbmc.service" library="service.py" />
</addon>